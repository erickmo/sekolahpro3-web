{$CUSTOM_DOMAIN} {
    handle /api/* { reverse_proxy frappe-backend:8000 }
    handle /siswa/* {
        root * /srv/sekolahpro-web/student
        try_files {path} /siswa/index.html
        file_server
    }
    handle {
        root * /srv/sekolahpro-web/school
        try_files {path} /index.html
        file_server
    }
}
